#!/usr/bin/env bash
# Print this session's Author block for a GitHub post or a report, so Session IDs are
# copied by the shell, never retyped by a model.
# Usage: handoff-author --tool <Codex|Claude Code|Pi> --model <model>
#   An empty --model omits AI-Assisted-By. A Session ID the runtime does not expose is null.
#   Reads only CODEX_SESSION_ID, CLAUDE_CODE_SESSION_ID or PI_SESSION_ID (by tool) and CHIRP_SESSION_ID.
#   Inside a herdr pane (HERDR_ENV=1) CHIRP_SESSION_ID is inherited from the shell that started herdr, so it is not read.
set -u

tool="" model="" have_model=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --tool) tool="${2:-}"; shift 2 ;;
    --model) model="${2:-}"; have_model=1; shift 2 ;;
    -h|--help) sed -n '2,6p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) printf 'handoff-author: unknown argument: %s\n' "$1" >&2; exit 1 ;;
  esac
done
[[ -n "$tool" && $have_model == 1 ]] || { printf 'handoff-author: --tool and --model are required\n' >&2; exit 1; }

case "$tool" in
  Codex) native="${CODEX_SESSION_ID:-${CODEX_THREAD_ID:-}}" ;;
  "Claude Code") native="${CLAUDE_CODE_SESSION_ID:-}" ;;
  Pi) native="${PI_SESSION_ID:-}" ;;
  *) native="" ;;
esac

printf 'Co-Authored-By: %s\n' "$tool"
[[ -n "$model" ]] && printf 'AI-Assisted-By: %s\n' "$model"
printf 'SESSION-ID: %s\n' "${native:-null}"
xirp="${CHIRP_SESSION_ID:-}"; [[ "${HERDR_ENV:-}" == 1 ]] && xirp=""
printf 'XIRP-SESSION-ID: %s\n' "${xirp:-null}"
