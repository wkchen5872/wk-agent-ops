#!/usr/bin/env bash
# Clean up a finished handoff loop: archive its records, delete its sessions (Xirp) or close what it
# opened (herdr, the Herdr app), then remove its worktrees.
# Usage: handoff-cleanup <change-id> [--abandon] [--yes]
#   --yes       act; without it the command only lists what it would remove
#   --abandon   clean up a loop that will not finish (no finish/done record needed)
# Requirements: the newest record is finish/done (unless --abandon) and every loop worktree is clean.
# Records and review reports move to <main worktree>/.agent-handoff/archive/<change-id>/, and so do
# the work-items/WI-* directories of every worktree that is removed.
# The main worktree and the feature branch are never removed; merging stays separate.
# A .pi/settings.json the loop wrote for a Pi role in the kept main worktree is removed.
set -u

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$here/lib/handoff.sh" ]]; then lib="$here/lib/handoff.sh"
else lib="$HOME/.config/wk-workflow/handoff/lib/handoff.sh"; fi
# shellcheck source=lib/handoff.sh
source "$lib" || { echo "handoff-cleanup: cannot load $lib" >&2; exit 1; }

die() { printf 'handoff-cleanup: %s\n' "$1" >&2; exit 1; }
change="" yes=0 abandon=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) sed -n '2,10p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --yes) yes=1; shift ;;
    --abandon) abandon=1; shift ;;
    -*) die "unknown option: $1" ;;
    *) [[ -z "$change" ]] || die "only one change id is allowed"; change="$1"; shift ;;
  esac
done
[[ "$change" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "usage: handoff-cleanup <change-id> [--abandon] [--yes]"

dir="$(ho_find_loop_dir "$change")" || die "no loop for '$change' in this repository's worktrees"
main="$(cd "$(ho_main_worktree "$dir")" && pwd -P)" || die "cannot find the main worktree"

rec="$(ho_newest_in_loop "$dir")" || rec=""
if (( ! abandon )); then
  [[ -n "$rec" ]] || die "the loop has no records yet (use --abandon to drop it)"
  if [[ "$(kv_get "$rec" role)" != finish || "$(kv_get "$rec" status)" != done ]]; then
    die "the loop is not finished: the newest record is $(basename "$rec") (status $(kv_get "$rec" status)); run handoff-finish first, or use --abandon to drop it"
  fi
fi

# Worktrees and sessions named by any copy of loop.yaml. Xirp sessions are deleted one by one;
# for herdr roles cleanup closes what the loop opened: its workspace, or the role's tab (design D3).
dirs=() wts=() sessions=() herdr_items=() herdr_dirs=() herdr_roles=() happ_items=() happ_dirs=() happ_roles=()
# The app's layout decides whether a loop space holds anything else (then only the loop's tabs close).
happ_ls="$(command -v herdr-app >/dev/null 2>&1 && ho_happ_ls)" || happ_ls=""
while IFS= read -r d; do
  dirs+=("$d")
  wt="$(cd "$d/../.." && pwd -P)"
  case " ${wts[*]-} " in *" $wt "*) ;; *) wts+=("$wt") ;; esac
  for k in implementer reviewer finish; do
    s="$(kv_get "$d/loop.yaml" "$k.session" 2>/dev/null)" || continue
    [[ -n "$s" ]] || continue
    if [[ "$(ho_role_host "$d/loop.yaml" "$k")" == herdr ]]; then
      t="$(ho_herdr_close_target "$d" "$k")" || continue
      for x in "${herdr_items[@]-}"; do [[ "$x" == "$t" ]] && continue 2; done
      herdr_items+=("$t"); herdr_dirs+=("$d"); herdr_roles+=("$k")
    elif [[ "$(ho_role_host "$d/loop.yaml" "$k")" == herdr-app ]]; then
      # Every role is closed (a space already closed is skipped) so that each terminal is removed; listed once.
      t="$(ho_happ_close_target "$d" "$k" "$happ_ls")" || continue
      for x in "${happ_roles[@]-}"; do [[ "$x" == "$k" ]] && continue 2; done
      happ_dirs+=("$d"); happ_roles+=("$k")
      for x in "${happ_items[@]-}"; do [[ "$x" == "$t" ]] && continue 2; done
      happ_items+=("$t")
    else
      case " ${sessions[*]-} " in *" $s "*) ;; *) sessions+=("$s") ;; esac
    fi
  done
done < <(ho_loop_dirs "$dir")

for wt in "${wts[@]}"; do
  ho_clean "$wt" || die "$wt has uncommitted changes; commit or clean them first"
done

# Work Items of the worktrees that will be removed; the kept main worktree keeps its own.
wis=()
for wt in "${wts[@]}"; do
  [[ "$wt" == "$main" ]] && continue
  for w in "$wt"/work-items/WI-*/; do [[ -d "$w" ]] && wis+=("${w%/}"); done
done

if (( abandon )); then printf 'Cleanup for %s (abandon: newest record %s)\n' "$change" "$(basename "${rec:-none}")"
else printf 'Cleanup for %s\n' "$change"; fi
printf '  sessions to delete:\n'; for s in "${sessions[@]-}"; do [[ -n "$s" ]] && printf '    %s\n' "$s"; done
if (( ${#herdr_items[@]} )); then
  printf '  herdr to close:\n'; for t in "${herdr_items[@]}"; do printf '    herdr %s\n' "$t"; done
fi
if (( ${#happ_items[@]} )); then
  printf '  Herdr app to close:\n'; for t in "${happ_items[@]}"; do printf '    herdr-app %s\n' "$t"; done
fi
printf '  worktrees to remove:\n'
for wt in "${wts[@]}"; do [[ "$wt" == "$main" ]] && printf '    %s (main worktree: kept)\n' "$wt" || printf '    %s\n' "$wt"; done
for wt in "${wts[@]}"; do
  [[ "$wt" == "$main" ]] || continue
  pis="$(ho_pi_settings_owned "$main/.agent-handoff/$change/loop.yaml" "$main")" && printf '  Pi settings to remove: %s\n' "$pis"
done
printf '  records archived to: %s/.agent-handoff/archive/%s/\n' "$main" "$change"
if (( ${#wis[@]} )); then
  printf '  Work Items archived with them:\n'; for w in "${wis[@]}"; do printf '    %s\n' "$w"; done
fi
printf '  kept: branch feature/%s\n' "$change"
if (( ! yes )); then printf '\nNothing changed. Run again with --yes to clean up.\n'; exit 0; fi

# 1. Archive records and the review reports they reference.
arc="$main/.agent-handoff/archive/$change"
for d in "${dirs[@]}"; do
  wt="$(cd "$d/../.." && pwd -P)"; to="$arc/$(basename "$wt")"
  mkdir -p "$to" && cp -R "$d/." "$to/" || die "could not archive $d; nothing was removed"
  for f in "$d"/[0-9][0-9]-review.yaml; do
    [[ -e "$f" ]] || continue
    r="$(kv_get "$f" report 2>/dev/null)" || continue
    [[ -n "$r" && -f "$wt/$r" ]] || continue
    mkdir -p "$to/$(dirname "$r")" && cp "$wt/$r" "$to/$r" || die "could not archive $wt/$r; nothing was removed"
  done
done
for w in "${wis[@]-}"; do
  [[ -n "$w" ]] || continue
  to="$arc/$(basename "${w%/work-items/*}")/work-items"
  mkdir -p "$to" && cp -R "$w" "$to/" || die "could not archive $w; nothing was removed"
done
printf 'Archived records in %s\n' "$arc"

# 2. Delete the sessions (the worktrees are removed below, once each).
if command -v xirp >/dev/null 2>&1; then
  for s in "${sessions[@]-}"; do
    [[ -n "$s" ]] || continue
    if ho_host_close xirp "" "" "$s"; then printf 'Deleted session %s\n' "$s"
    else printf 'Session %s was not deleted (already gone?)\n' "$s"; fi
  done
elif (( ${#sessions[@]} )); then
  printf 'xirp not found: sessions were not deleted\n'
fi
# herdr: close before the worktrees go, or herdr would resume the agents in them on a server restart.
# A close herdr does not confirm stops here: the worktrees and loop records stay for a rerun.
herdr_failed=0
for i in "${!herdr_items[@]}"; do
  if ! command -v herdr >/dev/null 2>&1; then printf 'herdr not found: herdr %s was not closed\n' "${herdr_items[$i]}" >&2; herdr_failed=1; continue; fi
  if ho_host_close herdr "${herdr_dirs[$i]}" "${herdr_roles[$i]}" ""; then printf 'Closed herdr %s\n' "${herdr_items[$i]}"
  else herdr_failed=1; fi
done
for i in "${!happ_roles[@]}"; do
  if ! command -v herdr-app >/dev/null 2>&1 || ! command -v hc >/dev/null 2>&1; then
    printf 'herdr-app or hc not found: the Herdr app spaces and tabs were not closed\n' >&2; herdr_failed=1; break
  fi
  if ho_host_close herdr-app "${happ_dirs[$i]}" "${happ_roles[$i]}" ""; then printf 'Closed the Herdr app tab or space of the %s\n' "${happ_roles[$i]}"
  else herdr_failed=1; break; fi
done
(( herdr_failed )) && die "herdr or the Herdr app did not confirm closing what the loop opened; no worktree was removed. Start herdr or open the Herdr app (or close them yourself), then run handoff-cleanup $change --yes again"

# 3. Remove the loop worktrees; the main worktree keeps its files, minus the moved records.
rc=0
for wt in "${wts[@]}"; do
  if [[ "$wt" == "$main" ]]; then
    ho_pi_settings_cleanup "$main/.agent-handoff/$change/loop.yaml" "$main"
    rm -rf "$main/.agent-handoff/$change"; continue
  fi
  if git -C "$main" worktree remove "$wt"; then printf 'Removed worktree %s\n' "$wt"
  else printf 'Could not remove worktree %s\n' "$wt" >&2; rc=1; fi
done
printf 'Branch feature/%s is kept; merge and delete it separately.\n' "$change"
exit $rc
