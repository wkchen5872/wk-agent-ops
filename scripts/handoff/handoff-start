#!/usr/bin/env bash
# Start an implement–review–finish loop for one OpenSpec change.
# Usage: handoff-start <change-id> [--worktree new|here] [--impl <override>]
#                      [--review <override>] [--finish ask|auto] [--reviewer-session <id>]
#   --worktree new|here         new (default): open the implementer in ../<repo>-<change-id>;
#                               here: use the current checkout, which must be on feature/<change-id>
#   --impl <override>           override the implement template for this loop
#   --review <override>         override the review template for this loop
#                               <override>: claude|codex:<model>:<effort> or pi:<provider>/<model>:<effort>:<billing>
#   --finish ask|auto           override finish.trigger for this loop
#   --reviewer-session <id>     reuse an existing session (Xirp ID, herdr pane or Herdr app terminal) as the reviewer
# Role templates: <main worktree>/.agent-handoff/roles.yaml (not tracked by Git).
# The handoff-doctor checks run first for all three roles; any failure opens nothing.
set -u

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$here/lib/handoff.sh" ]]; then lib="$here/lib/handoff.sh"
else lib="$HOME/.config/wk-workflow/handoff/lib/handoff.sh"; fi
# shellcheck source=lib/handoff.sh
source "$lib" || { echo "handoff-start: cannot load $lib" >&2; exit 1; }

usage() { sed -n '2,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }
die() { printf 'handoff-start: %s\n' "$1" >&2; exit 1; }
# unconfirmed <loop-dir> <session> <worktree> <head>: the host did not confirm the implementer's first prompt. It is
# not sent again (the host's message names the file holding it); one attention notice says so (codex-herdr-app-r01/F-04).
unconfirmed() {
  ho_notify "$(jq -nc --arg c "$change" --arg h "${4:0:7}" --arg w "$3" '{change:$c, round:"1", commit:$h, agent:"", session_id:"", cwd:$w}')" \
    attention "" "到該 Session 確認是否收到；沒收到就把 $1/implementer-unconfirmed.txt 的內容貼給它，再刪掉該檔案。" \
    "無法確認交給 implementer 的第一則 prompt 是否送達（Session ${2}），未重送。"
}

change="" mode="new" impl_ov="" review_ov="" finish_ov="" reviewer="" reviewer_native=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --worktree) mode="${2:-}"; shift 2 ;;
    --impl) impl_ov="${2:-}"; shift 2 ;;
    --review) review_ov="${2:-}"; shift 2 ;;
    --finish) finish_ov="${2:-}"; shift 2 ;;
    --reviewer-session) reviewer="${2:-}"; shift 2 ;;
    -*) die "unknown option: $1" ;;
    *) [[ -z "$change" ]] || die "only one change id is allowed"; change="$1"; shift ;;
  esac
done
[[ -n "$change" ]] || { usage >&2; exit 1; }
[[ "$change" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "change must be a kebab-case id"
[[ "$mode" == new || "$mode" == here ]] || die "--worktree must be new or here"
[[ -z "$finish_ov" || "$finish_ov" == ask || "$finish_ov" == auto ]] || die "--finish must be ask or auto"
for ov in "$impl_ov" "$review_ov"; do
  [[ -z "$ov" ]] || ho_override_valid "$ov" \
    || die "override must be claude|codex:<model>:<effort> or pi:<provider>/<model>:<effort>:<billing>, got '$ov'"
done
main="$(ho_main_worktree)" || die "not inside a Git repository"
roles="$main/.agent-handoff/roles.yaml"
# Work on a scratch copy so overrides never touch roles.yaml; check the environment before anything else.
scratch="$(mktemp)"; trap 'rm -f "$scratch" "$scratch.err"' EXIT
tfile="$roles"
if [[ -f "$roles" ]]; then
  cp "$roles" "$scratch"; tfile="$scratch"
  [[ -z "$impl_ov" ]] || ho_apply_override "$scratch" implement "$impl_ov"
  [[ -z "$review_ov" ]] || ho_apply_override "$scratch" review "$review_ov"
fi
ho_preflight_or_refuse handoff-start "$tfile" implement review finish || exit 1
git -C "$main" show-ref --verify --quiet "refs/heads/feature/$change" || die "branch feature/$change does not exist (run opsx-branch $change first)"
# The implementer works on the branch, so the change must be there (planning is usually committed on it).
git -C "$main" cat-file -e "feature/$change:openspec/changes/$change" 2>/dev/null \
  || die "no active OpenSpec change '$change' on feature/$change (commit its artifacts on that branch first)"

trigger="${finish_ov:-$(kv_get "$scratch" finish.trigger 2>/dev/null || true)}"; trigger="${trigger:-ask}"
delivery="$(kv_get "$scratch" finish.delivery 2>/dev/null || true)"; delivery="${delivery:-local}"
[[ "$trigger" == ask || "$trigger" == auto ]] || die "finish.trigger must be ask or auto"
[[ "$delivery" == local || "$delivery" == pr ]] || die "finish.delivery must be local or pr"
max="$(kv_get "$scratch" max_rounds 2>/dev/null || true)"; max="${max:-3}"

if [[ -n "$reviewer" ]]; then
  # The host reads the review role from a loop file; loop.yaml does not exist yet.
  rh="$(ho_sec_host "$scratch" review)"; rdir="$(mktemp -d)"
  printf 'review_template:\n  host: %s\n  harness: %s\nreviewer:\n  herdr_session: %s\n' "$rh" "$(kv_get "$scratch" review.harness)" \
    "$(ho_herdr_session_choice "$scratch")" > "$rdir/loop.yaml"
  ho_host_exists "$rh" "$rdir" reviewer "$reviewer"; found=$?
  reviewer_native="$(kv_get "$rdir/loop.yaml" reviewer.native_session 2>/dev/null)"; rm -rf "$rdir"
  (( found == 0 )) || die "the review role's $rh session '$reviewer' was not found"
fi

# What the harnesses require of the worktrees, before any worktree or session (design decisions 1, 2 and 8).
why="$(ho_harness_shared_worktree_error "$scratch" "")" || die "$why"
if [[ "$mode" == new ]]; then why="$(ho_harness_branch_error "$scratch" implement "$main" "feature/$change")" || die "$why"; fi

# An implementer that stopped at a dialog when this loop started: send the prompt to the same pane.
if dir="$(ho_find_loop_dir "$change" "$main")" && ho_role_pending "$dir" implementer; then
  wt="$(kv_get "$dir/loop.yaml" implementer.worktree)"
  id="$(ho_open_role "$dir" implement_template "$wt" "$(ho_head "$wt")" 1 "（無）")"; rc=$?
  if (( rc == 2 )); then
    id="$(kv_get "$dir/loop.yaml" implementer.session)"; unconfirmed "$dir" "$id" "$wt" "$(ho_head "$wt")"
    printf 'Implement prompt not confirmed for %s (not sent again)\n  implementer: %s\n  worktree:    %s\n' "$change" "$id" "$wt"; exit 0
  fi
  (( rc == 0 )) || die "the implementer still waits; answer the dialog, then run handoff-start $change again"
  kv_set "$dir/loop.yaml" implementer.session "$id"
  printf 'Implement prompt sent for %s\n  implementer: %s\n  worktree:    %s\n' "$change" "$id" "$wt"
  exit 0
fi

# Where the branch is checked out now, if anywhere.
in_use="$(git -C "$main" worktree list --porcelain | awk -v b="branch refs/heads/feature/$change" '/^worktree /{w=substr($0,10)} $0==b{print w}')"
if [[ "$mode" == new ]]; then
  [[ -z "$in_use" ]] || die "feature/$change is already checked out in $in_use (use --worktree here there, or free it)"
  wt="$(dirname "$main")/$(basename "$main")-$change"
  [[ ! -e "$wt" ]] || die "$wt already exists"
  git -C "$main" worktree add -q "$wt" "feature/$change" || die "cannot create worktree $wt"
else
  wt="$(ho_toplevel)" || die "not inside a Git worktree"
  [[ "$(git -C "$wt" branch --show-current)" == "feature/$change" ]] || die "--worktree here needs a checkout on feature/$change; $wt is on $(git -C "$wt" branch --show-current)"
fi
dir="$wt/.agent-handoff/$change"; loop="$dir/loop.yaml"
[[ ! -e "$loop" ]] || die "a loop already exists: $loop"
# A file the harness creates there is the loop's (handoff-cleanup removes it); its messages carry this command's name.
owned="$(ho_harness_prepare_worktree "$scratch" implement "$wt" 2>"$scratch.err")"; rc=$?
sed 's/^/handoff-start: /' "$scratch.err" >&2; (( rc == 0 )) || exit 1

mkdir -p "$dir"
{
  printf 'change: %s\nmax_rounds: %s\n' "$change" "$max"
  printf 'implementer:\n  session:\n  worktree: %s\n' "$wt"
  printf 'reviewer:\n  session: %s\n  worktree:\n' "$reviewer"
  printf 'finish:\n  session:\n  worktree:\n  trigger: %s\n  delivery: %s\n' "$trigger" "$delivery"
} > "$loop" || die "cannot write $loop"
[[ -n "$owned" ]] && kv_set "$loop" implementer.pi_settings "$owned"
# A reused herdr reviewer is known by the native session it ran when checked; a later different one is not it.
[[ -n "$reviewer_native" ]] && kv_set "$loop" reviewer.native_session "$reviewer_native"
ho_copy_template "$scratch" implement "$loop" implement_template
ho_copy_template "$scratch" review "$loop" review_template
ho_copy_template "$scratch" finish "$loop" finish_template
for sec in implement review finish; do
  h="$(ho_sec_host "$scratch" "$sec")"; kv_set "$loop" "${sec}_template.host" "$h"
  [[ "$h" == herdr ]] && kv_set "$loop" "$(ho_role_key "$sec").herdr_session" "$(ho_herdr_session_choice "$scratch")"
done
impl_host="$(ho_role_host "$loop" implementer)"

if ! ho_harness_worktree_ready "$scratch" implement "$wt" "$main"; then
  die "the Pi trigger would not trust $wt (its loop.yaml does not list it); the implementer was not opened"
fi
head="$(ho_head "$wt")"
name="$(ho_render "$(kv_get "$scratch" implement.name)" "$change" "$head" 1 "（無）" "$delivery")"
prompt="$(ho_render "$(kv_get "$scratch" implement.prompt)" "$change" "$head" 1 "（無）" "$delivery" \
  "$(kv_get "$scratch" implement.harness)" "$(kv_get "$scratch" implement.model)")"
id="$(ho_host_open "$impl_host" "$dir" implementer "$wt" "$name" "$prompt" "$scratch" implement)"; rc=$?
if (( rc == 2 )); then
  id="$(kv_get "$loop" implementer.session)"; unconfirmed "$dir" "$id" "$wt" "$head"
elif (( rc != 0 )); then
  ho_role_pending "$dir" implementer && die "the implementer's pane is kept; fix the cause above (for a dialog, answer it there), then run handoff-start $change again"
  die "could not open the implementer session"
fi
kv_set "$loop" implementer.session "$id"

printf 'Loop started for %s\n  implementer: %s (%s)\n  worktree:    %s\n  loop:        %s\n  reviewer:    %s\n  finish:      trigger %s, delivery %s\n' \
  "$change" "$name" "$id" "$wt" "$loop" "${reviewer:-opened by the hook on the first handoff}" "$trigger" "$delivery"
