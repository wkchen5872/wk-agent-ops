#!/usr/bin/env bash
# Change the review or finish role of a running loop.
# Usage: handoff-role <change-id> <review|finish> [<override>] [--worktree new] [--replace]
#   <override>: claude|codex:<model>:<effort> or pi:<provider>/<model>:<effort>:<billing>
#   --worktree new  run the role in a worktree of its own instead of the implementer's
#   --replace       replace a role whose session is open: delete that session first, then hand the
#                   new role the record waiting for it, if any (make sure the old role has stopped)
# Runs the handoff-doctor checks for that role and the one-Pi-role-per-worktree check, and changes
# nothing unless all pass. The implementer and roles.yaml are never changed.
set -u

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$here/lib/handoff.sh" ]]; then lib="$here/lib/handoff.sh"
else lib="$HOME/.config/wk-workflow/handoff/lib/handoff.sh"; fi
# shellcheck source=lib/handoff.sh
source "$lib" || { echo "handoff-role: cannot load $lib" >&2; exit 1; }

die() { printf 'handoff-role: %s\n' "$1" >&2; exit 1; }
usage="usage: handoff-role <change-id> <review|finish> [<override>] [--worktree new] [--replace]"
args=() replace=0 wtmode=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) sed -n '2,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --replace) replace=1; shift ;;
    --worktree) [[ "${2:-}" == new ]] || die "only --worktree new is supported (a role cannot move back to the implementer's worktree), got '${2:-}'"
      wtmode=new; shift 2 ;;
    -*) die "unknown option: $1" ;;
    *) args+=("$1"); shift ;;
  esac
done
(( ${#args[@]} == 2 || ${#args[@]} == 3 )) || die "$usage"
change="${args[0]}" role="${args[1]}" ov="${args[2]:-}"
[[ "$change" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "change must be a kebab-case id"
case "$role" in
  review) key=reviewer ;; finish) key=finish ;;
  implement) die "only review and finish roles can be changed; the implementer cannot" ;;
  *) die "role must be review or finish, got '$role'" ;;
esac
[[ -n "$ov" || -n "$wtmode" ]] || die "$usage"
[[ -z "$ov" || "$ov" =~ ^(claude|codex):[^:]+:[^:]+$ || "$ov" =~ ^pi:[^:/]+/[^:/]+:[^:]+:[^:]+$ ]] \
  || die "override must be claude|codex:<model>:<effort> or pi:<provider>/<model>:<effort>:<billing>, got '$ov'"

dir="$(ho_find_loop_dir "$change")" || die "no loop for '$change' in this repository's worktrees"
loop="$dir/loop.yaml"
old="$(kv_get "$loop" "$key.session" 2>/dev/null || true)"
(( replace )) || [[ -z "$old" ]] || die "the $role session is already open ($old); add --replace to delete it and use the new role in its place"
rec="$(ho_newest_in_loop "$dir")" || rec=""
rstate=""; [[ -n "$rec" ]] && rstate="$(kv_get "$rec" role)/$(kv_get "$rec" status)/$(kv_get "$rec" verdict 2>/dev/null)"
# A blocked finish retries in the worktree that holds its commits (ho_finish_retry), whatever the template says.
if [[ -n "$old" && "$role" == finish && -n "$wtmode" && "$rstate" == finish/blocked/* \
  && "$(kv_get "$loop" finish_template.worktree 2>/dev/null)" != new ]]; then
  die "the blocked finish continues in the implementer's worktree, which holds its commits; replace it without --worktree new"
fi

# change_role <loop.yaml>: apply the requested settings to one copy of loop.yaml.
change_role() {
  [[ -z "$ov" ]] || ho_apply_override "$1" "${role}_template" "$ov"
  [[ -z "$wtmode" ]] || kv_set "$1" "${role}_template.worktree" new
}
scratch="$(mktemp)"; trap 'rm -f "$scratch"' EXIT
cp "$loop" "$scratch"
change_role "$scratch"
ho_preflight_or_refuse handoff-role "$scratch" "${role}_template" || exit 1

# One Pi role per worktree: the implementer, plus every review or finish role not in a worktree of its own.
pi_in_impl=()
for sec in implement review finish; do
  [[ "$(kv_get "$scratch" "${sec}_template.harness" 2>/dev/null)" == pi ]] || continue
  [[ "$sec" == implement || "$(kv_get "$scratch" "${sec}_template.worktree" 2>/dev/null || true)" != new ]] && pi_in_impl+=("$sec")
done
if (( ${#pi_in_impl[@]} > 1 )); then
  roles_txt="${pi_in_impl[*]}"
  die "Pi roles ${roles_txt// / and } would share the implementer worktree; a worktree holds one Pi role, so set worktree: new for the Pi review or finish role"
fi

# Delete the old session before writing: an old reviewer must not record a review after the change (design D2).
if [[ -n "$old" ]]; then
  host="$(ho_role_host "$loop" "$key")"
  if [[ "$host" == herdr ]] || ho_host_exists "$host" "$dir" "$key" "$old"; then
    ho_host_close "$host" "$dir" "$key" "$old" tab || die "could not delete the old $role session $old through $host; nothing was changed"
  fi
fi

dirs="$(ho_loop_dirs "$dir")"
oldmode="$(kv_get "$loop" "${role}_template.worktree" 2>/dev/null || echo shared)"
cat "$scratch" > "$loop" || die "could not write $loop"
while IFS= read -r d; do
  [[ "$d" == "$dir" ]] || change_role "$d/loop.yaml"
  [[ -n "$old" ]] || continue
  clear="session native_session herdr_tab pending_prompt"
  [[ "$key" == finish ]] && clear+=" retried_for"
  # A reviewer moving out of the implementer's worktree gets <root>-review from the route.
  [[ "$key" == reviewer && "$oldmode" != new && -n "$wtmode" ]] && clear+=" worktree"
  for k in $clear; do kv_get "$d/loop.yaml" "$key.$k" >/dev/null 2>&1 && kv_set "$d/loop.yaml" "$key.$k" ""; done
done <<<"$dirs"
printf '%s role for %s: %s / %s / %s (worktree %s)\n' "$role" "$change" "$(kv_get "$loop" "${role}_template.harness")" \
  "$(kv_get "$loop" "${role}_template.model")" "$(kv_get "$loop" "${role}_template.effort")" \
  "$(kv_get "$loop" "${role}_template.worktree" 2>/dev/null || echo shared)"
[[ -n "$old" ]] || exit 0
ho_log "$dir" "handoff-role replaced the $role session $old"
printf 'Deleted the old %s session %s\n' "$role" "$old"

# Hand the new role the record that waited for the old one (design D3), through the usual paths.
[[ -n "$rec" ]] || exit 0
base="$(basename "$rec")"
if [[ "$role" == review && "$rstate" == implement/done/* ]]; then
  rdir="$(dirname "$rec")"; wt="$(cd "$rdir/../.." && pwd)"
  for f in .routed .notified; do
    [[ -f "$rdir/$f" ]] || continue
    grep -vxF "$base" "$rdir/$f" > "$rdir/$f.tmp"; mv "$rdir/$f.tmp" "$rdir/$f"
  done
  if [[ -f "$here/handoff-route" ]]; then route="$here/handoff-route"; else route="$HOME/.config/wk-workflow/handoff/handoff-route"; fi
  (cd "$wt" && bash "$route" --foreground </dev/null >/dev/null 2>&1)
  action="$(grep -F " $base action=" "$rdir/routing.log" 2>/dev/null | tail -1 | sed 's/.* action=\([^ ]*\).*/\1/')"
  case "$action" in
    reviewer:opened:*) printf 'Handed %s to the new reviewer (%s)\n' "$base" "$action" ;;
    *) die "the review role was replaced, but $base did not reach the new reviewer (${action:-no route result}); see $rdir/routing.log, then retry in $wt with: bash $route --foreground" ;;
  esac
elif [[ "$role" == finish && ( "$rstate" == finish/blocked/* || "$rstate" == review/done/pass ) ]]; then
  rmdir "$dir"/.finish-retry-* 2>/dev/null
  if out="$("$here/handoff-finish" "$change" 2>&1)"; then
    ho_log "$dir" "$base action=finish:opened:${out##* } trigger=handoff-role"
    printf '%s\n' "$out"
  else
    ho_log "$dir" "$base action=finish:open-failed trigger=handoff-role"
    die "the finish role was replaced, but no finish session opened (${out##*$'\n'}); retry with: handoff-finish $change"
  fi
fi
