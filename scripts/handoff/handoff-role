#!/usr/bin/env bash
# Change the review or finish role of a running loop.
# Usage: handoff-role <change-id> <review|finish> [<override>] [--worktree new] [--replace]
#   <override>: claude|codex:<model>:<effort> or pi:<provider>/<model>:<effort>:<billing>
#   --worktree new  run the role in a worktree of its own instead of the implementer's
#   --replace       replace a role whose session is open: delete that session first, then hand the
#                   new role the record waiting for it, if any (make sure the old role has stopped)
# Runs the handoff-doctor checks for that role and the one-Pi-role-per-worktree check, and changes
# nothing unless all pass. The implementer and roles.yaml are never changed.
set -u

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$here/lib/handoff.sh" ]]; then lib="$here/lib/handoff.sh"
else lib="$HOME/.config/wk-workflow/handoff/lib/handoff.sh"; fi
# shellcheck source=lib/handoff.sh
source "$lib" || { echo "handoff-role: cannot load $lib" >&2; exit 1; }

die() { printf 'handoff-role: %s\n' "$1" >&2; exit 1; }
usage="usage: handoff-role <change-id> <review|finish> [<override>] [--worktree new] [--replace]"
args=() replace=0 wtmode=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) sed -n '2,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --replace) replace=1; shift ;;
    --worktree) [[ "${2:-}" == new ]] || die "only --worktree new is supported (a role cannot move back to the implementer's worktree), got '${2:-}'"
      wtmode=new; shift 2 ;;
    -*) die "unknown option: $1" ;;
    *) args+=("$1"); shift ;;
  esac
done
(( ${#args[@]} == 2 || ${#args[@]} == 3 )) || die "$usage"
change="${args[0]}" role="${args[1]}" ov="${args[2]:-}"
[[ "$change" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "change must be a kebab-case id"
case "$role" in
  review) key=reviewer ;; finish) key=finish ;;
  implement) die "only review and finish roles can be changed; the implementer cannot" ;;
  *) die "role must be review or finish, got '$role'" ;;
esac
[[ -n "$ov" || -n "$wtmode" ]] || die "$usage"
[[ -z "$ov" || "$ov" =~ ^(claude|codex):[^:]+:[^:]+$ || "$ov" =~ ^pi:[^:/]+/[^:/]+:[^:]+:[^:]+$ ]] \
  || die "override must be claude|codex:<model>:<effort> or pi:<provider>/<model>:<effort>:<billing>, got '$ov'"

dir="$(ho_find_loop_dir "$change")" || die "no loop for '$change' in this repository's worktrees"
loop="$dir/loop.yaml" tsec="${role}_template"
old="$(kv_get "$loop" "$key.session" 2>/dev/null || true)"
(( replace )) || [[ -z "$old" ]] || die "the $role session is already open ($old); add --replace to delete it and use the new role in its place"
rec="$(ho_newest_in_loop "$dir")" || rec=""
rstate="" until=""
if [[ -n "$rec" ]]; then
  rstate="$(kv_get "$rec" role)/$(kv_get "$rec" status)/$(kv_get "$rec" verdict 2>/dev/null)"
  # Records written so far answer to the template being replaced (ho_record_tsec).
  until="$(printf '%02d' $((10#$(basename "$rec" | cut -c1-2) + 1)))"
fi

# change_role <loop.yaml>: keep the current template for the records so far, then apply the new settings.
change_role() {
  local f="$1" k v snap="${tsec}_until_$until" whole=1
  for k in harness provider model effort billing; do kv_get "$f" "$snap.$k" >/dev/null 2>&1 || whole=0; done
  if [[ -n "$until" ]] && (( ! whole )); then
    for k in harness provider model effort billing; do
      v="$(kv_get "$f" "$tsec.$k" 2>/dev/null)"; kv_set "$f" "$snap.$k" "${v:+\"$v\"}" || return 1
    done
  fi
  [[ -z "$ov" ]] || ho_apply_override "$f" "$tsec" "$ov" || return 1
  [[ -z "$wtmode" ]] || kv_set "$f" "$tsec.worktree" new
}
scratch="$(mktemp)" || die "cannot create a temporary file; nothing was changed"
trap 'rm -f "$scratch"' EXIT
cp "$loop" "$scratch" && change_role "$scratch" || die "cannot prepare the new settings from $loop; nothing was changed"
ho_preflight_or_refuse handoff-role "$scratch" "$tsec" || exit 1

# One Pi role per worktree: the implementer, plus every review or finish role not in a worktree of its own.
pi_in_impl=()
for sec in implement review finish; do
  [[ "$(kv_get "$scratch" "${sec}_template.harness" 2>/dev/null)" == pi ]] || continue
  [[ "$sec" == implement || "$(kv_get "$scratch" "${sec}_template.worktree" 2>/dev/null || true)" != new ]] && pi_in_impl+=("$sec")
done
if (( ${#pi_in_impl[@]} > 1 )); then
  roles_txt="${pi_in_impl[*]}"
  die "Pi roles ${roles_txt// / and } would share the implementer worktree; a worktree holds one Pi role, so set worktree: new for the Pi review or finish role"
fi

# Pi settings: the old role's file is replaced only when the loop wrote it and nobody changed it since; any
# other file in the worktree the new Pi role opens in must already match, as ho_pi_settings requires.
drop_pi=""
if [[ -n "$old" ]]; then
  f="$(kv_get "$loop" "$key.pi_settings" 2>/dev/null)"
  [[ -n "$f" && "$(ho_pi_settings_owned "$loop" "${f%/.pi/settings.json}" 2>/dev/null)" == "$f" ]] && drop_pi="$f"
fi
if [[ "$(kv_get "$scratch" "$tsec.harness")" == pi ]]; then
  # Where the route or handoff-finish will open the role: twt, used as it is (tcommit "-"), or first checked out at
  # tcommit, or at a commit not known yet (tcommit ""; checked when it opens).
  impl="$(kv_get "$loop" implementer.worktree)" nmode="$(kv_get "$scratch" "$tsec.worktree" 2>/dev/null)" rhead=""
  [[ -n "$rec" ]] && rhead="$(kv_get "$rec" head 2>/dev/null)"
  twt="$impl" tcommit="-"
  if [[ "$role" == review && "$nmode" == new ]]; then
    twt="$impl-review" tcommit=""; [[ "$rstate" == implement/done/* ]] && tcommit="$rhead"
  elif [[ "$role" == finish && "$rstate" == finish/blocked/* ]]; then
    twt="$(kv_get "$loop" finish.worktree 2>/dev/null)"; twt="${twt:-$impl}"
    [[ "$nmode" == new && "$twt" == "$impl" ]] && { twt="$impl-finish" tcommit="$(ho_head "$impl")"; }
  elif [[ "$role" == finish && "$nmode" == new ]]; then
    twt="$impl-finish" tcommit=""; [[ "$rstate" == review/done/pass ]] && tcommit="$rhead"
  fi
  if [[ "$tcommit" == - ]]; then
    # The index decides, so a file hidden with skip-worktree still counts.
    [[ -z "$(git -C "$twt" ls-files -- .pi/settings.json 2>/dev/null)" ]] \
      || die "$twt/.pi/settings.json is tracked by Git; a Pi role cannot use $twt; nothing was changed"
  elif [[ -n "$tcommit" ]] && git -C "$impl" cat-file -e "$tcommit:.pi/settings.json" 2>/dev/null; then
    die "$twt would check out ${tcommit:0:7}, where .pi/settings.json is tracked by Git; a Pi role cannot use it; nothing was changed"
  fi
  f="$twt/.pi/settings.json"
  if [[ -e "$f" && "$f" != "$drop_pi" && -z "$(git -C "$twt" ls-files -- .pi/settings.json 2>/dev/null)" ]]; then
    [[ "$(jq -cS . "$f" 2>/dev/null)" == "$(ho_pi_settings_json "$(kv_get "$scratch" "$tsec.provider")" "$(kv_get "$scratch" "$tsec.model")" "$(kv_get "$scratch" "$tsec.effort")")" ]] \
      || die "$f already exists with other settings that this loop did not write; remove it or use --worktree new; nothing was changed"
  fi
fi

# Delete the old session before writing: an old reviewer must not record a review after the change (design D2).
if [[ -n "$old" ]]; then
  host="$(ho_role_host "$loop" "$key")"
  why="$(ho_role_close "$host" "$dir" "$key" "$old" "$(kv_get "$loop" "$tsec.harness")" 2>&1)" \
    || die "the old $role session $old was not closed (${why##*$'\n'}); nothing was changed"
  if [[ -n "$drop_pi" ]]; then rm -f "$drop_pi"; rmdir "${drop_pi%/settings.json}" 2>/dev/null; fi
fi

# Write every other copy first and the implementer's loop.yaml last: until it is written it still names the old
# session, so running the same command again finishes the job.
clear=""
if [[ -n "$old" ]]; then
  clear="session native_session herdr_tab pending_prompt pi_settings"
  [[ "$key" == finish ]] && clear+=" retried_for"
  # A reviewer moving out of the implementer's worktree gets <root>-review from the route.
  [[ "$key" == reviewer && "$(kv_get "$loop" "$tsec.worktree" 2>/dev/null)" != new && -n "$wtmode" ]] && clear+=" worktree"
fi
clear_role() { local k; for k in $clear; do kv_get "$1" "$key.$k" >/dev/null 2>&1 && { kv_set "$1" "$key.$k" "" || return 1; }; done; return 0; }
rerun="fix that, then run the same handoff-role command again (with --replace)"
dirs="$(ho_loop_dirs "$dir")"
# Each copy is replaced whole (written to a temporary file, then renamed), so a failure leaves it as it was.
while IFS= read -r d; do
  [[ "$d" == "$dir" ]] && continue
  t="$d/loop.yaml.new.$$"
  cp "$d/loop.yaml" "$t" && change_role "$t" && clear_role "$t" && mv "$t" "$d/loop.yaml" \
    || { rm -f "$t"; die "${old:+the old $role session $old was deleted, but }$d/loop.yaml could not be written; $rerun"; }
done <<<"$dirs"
clear_role "$scratch" && cat "$scratch" > "$loop.new.$$" && mv "$loop.new.$$" "$loop" \
  || { rm -f "$loop.new.$$"; die "${old:+the old $role session $old was deleted, but }$loop could not be written; $rerun"; }
printf '%s role for %s: %s / %s / %s (worktree %s)\n' "$role" "$change" "$(kv_get "$loop" "$tsec.harness")" \
  "$(kv_get "$loop" "$tsec.model")" "$(kv_get "$loop" "$tsec.effort")" "$(kv_get "$loop" "$tsec.worktree" 2>/dev/null || echo shared)"
[[ -n "$old" ]] || exit 0
# A prompt to the old session that herdr did not confirm no longer holds back the new one.
while IFS= read -r d; do rm -f "$d/$key-unconfirmed.txt"; done <<<"$dirs"
ho_log "$dir" "handoff-role replaced the $role session $old"
printf 'Deleted the old %s session %s\n' "$role" "$old"

# Hand the new role the record that waited for the old one (design D3), through the usual paths.
[[ -n "$rec" ]] || exit 0
base="$(basename "$rec")" rdir="$(dirname "$rec")"
if [[ "$role" == review && "$rstate" == implement/done/* ]] && grep -qxF "$base" "$rdir/.routed" 2>/dev/null \
  && grep -qE " $base action=reviewer:(opened|messaged):$old( |\$)" "$rdir/routing.log" 2>/dev/null; then
  wt="$(cd "$rdir/../.." && pwd)"
  if [[ -f "$here/handoff-route" ]]; then route="$here/handoff-route"; else route="$HOME/.config/wk-workflow/handoff/handoff-route"; fi
  manual="remove the line $base from $rdir/.routed, then run in $wt: bash $route --foreground"
  # unmark <file>: drop the record from a route marker file; fails when the file could not be rewritten.
  unmark() {
    [[ -f "$1" ]] || return 0
    { grep -vxF "$base" "$1" > "$1.tmp"; (( $? <= 1 )); } && mv "$1.tmp" "$1" || { rm -f "$1.tmp"; return 1; }
  }
  unmark "$rdir/.routed" || die "the review role was replaced, but $base is still marked as processed; $manual"
  unmark "$rdir/.notified" || die "the review role was replaced, but $rdir/.notified could not be updated; fix that, then run in $wt: bash $route --foreground"
  n0="$(wc -l < "$rdir/routing.log" 2>/dev/null || echo 0)"
  # The route finds its worktree in CLAUDE_PROJECT_DIR before the working directory: point both at the record's.
  (cd "$wt" && CLAUDE_PROJECT_DIR="$wt" bash "$route" --foreground </dev/null >/dev/null 2>&1)
  action="$(tail -n +$((n0 + 1)) "$rdir/routing.log" 2>/dev/null | grep -F " $base action=" | tail -1 | sed 's/.* action=\([^ ]*\).*/\1/')"
  # The loop's state, not the log, says whether the round may have reached a reviewer: a recorded session whose first
  # prompt is not pending was opened with it (Xirp) or was sent it (herdr, confirmed or not). Such a record stays
  # processed so that nothing sends it again; only a record that reached no one is left for a retry.
  sess="$(kv_get "$loop" reviewer.session 2>/dev/null)"
  if [[ -n "$sess" ]] && ! ho_role_pending "$dir" reviewer; then
    grep -qxF "$base" "$rdir/.routed" 2>/dev/null || printf '%s\n' "$base" >> "$rdir/.routed" \
      || die "the new reviewer session $sess may have received $base, but $rdir/.routed could not be updated: add the line $base there so that it is not sent again"
    [[ "$action" == reviewer:opened:* ]] && { printf 'Handed %s to the new reviewer (%s)\n' "$base" "$action"; exit 0; }
    die "the review role was replaced and the new reviewer session $sess was opened, but the hand-off of $base is not confirmed (${action:-no result logged}); it is not sent again. Check that session as the attention notice says"
  fi
  # Nothing was sent: the record stays unprocessed so that a retry hands it over.
  unmark "$rdir/.routed" || die "the review role was replaced, but $base did not reach the new reviewer (${action:-no route result}) and is still marked as processed; $manual"
  die "the review role was replaced, but $base did not reach the new reviewer (${action:-no route result}); see $rdir/routing.log, then retry in $wt with: bash $route --foreground"
elif [[ "$role" == finish && ( "$rstate" == finish/blocked/* || "$rstate" == review/done/pass ) ]]; then
  rmdir "$dir"/.finish-retry-* 2>/dev/null
  if out="$("$here/handoff-finish" "$change" 2>&1)"; then
    ho_log "$dir" "$base action=finish:opened:${out##* } trigger=handoff-role"
    printf '%s\n' "$out"
  else
    ho_log "$dir" "$base action=finish:open-failed trigger=handoff-role"
    ho_notify "$(jq -nc --arg c "$change" --arg r "$(kv_get "$rec" round)" --arg h "$(kv_get "$rec" head | cut -c1-7)" --arg w "$dir" \
      '{change:$c, round:$r, commit:$h, agent:"", session_id:"", cwd:$w}')" attention "" "原因排除後執行：handoff-finish $change" \
      "已更換收尾角色，但無法開啟新的收尾 Session：${out##*$'\n'}"
    die "the finish role was replaced, but no finish session opened (${out##*$'\n'}); retry with: handoff-finish $change"
  fi
fi
