#!/usr/bin/env bash
# Stop hook for the agent handoff loop (Claude Code and Codex; Pi through pi/wk-handoff.ts).
# Reads the newest unprocessed handoff record in the stopping agent's worktree and
# routes it: notify the next agent through its host (Xirp or herdr), or notify the user, then tells the user
# what happened (progress or attention, see lib/handoff.sh ho_notify). Never writes to
# GitHub, never pushes, never blocks the agent: the work runs in the background and
# every failure ends with exit 0.
#   handoff-route              hook entry point (reads the hook payload on stdin)
#   handoff-route --foreground route synchronously (manual runs; notices carry no agent)
#   HANDOFF_ROUTE_WAIT=1       hook mode, but synchronous (tests)
set -u

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$here/lib/handoff.sh" ]]; then lib="$here/lib/handoff.sh"
else lib="$HOME/.config/wk-workflow/handoff/lib/handoff.sh"; fi

payload=""
if [[ ! -t 0 ]]; then payload="$(cat 2>/dev/null || true)"; fi
cwd="$(jq -r '.cwd // empty' <<<"$payload" 2>/dev/null || true)"
cwd="${cwd:-${CLAUDE_PROJECT_DIR:-$PWD}}"
native_session="$(jq -r '.session_id // empty' <<<"$payload" 2>/dev/null || true)"
manual=0

route() {
  # shellcheck source=lib/handoff.sh
  source "$lib" || return 0
  local root dir
  root="$(ho_toplevel "$cwd")" || return 0
  for dir in "$root"/.agent-handoff/*/; do
    dir="${dir%/}"
    [[ -f "$dir/loop.yaml" ]] || continue
    route_dir "$dir" "$root" || true
  done
}

# Each record ends in one outcome (design decision 5):
#   delivered — the next step was taken: progress notice, marked processed;
#   stop      — the loop waits for the user: one attention notice, marked processed;
#   retry     — sending or opening failed: one attention notice (.notified), left unprocessed
#               so a later hook run or `handoff-route --foreground` tries again.
route_dir() {
  local dir="$1" root="$2" rec base change role status verdict head round report loop max from
  local action="" outcome="stop" kind="attention" out_verdict="" next="" detail="" why sess_json ctx
  loop="$dir/loop.yaml"
  rec="$(ho_newest_in "$dir")" || return 0
  base="$(basename "$rec")"
  grep -qxF "$base" "$dir/.routed" 2>/dev/null && return 0

  change="$(kv_get "$loop" change)"; role="$(kv_get "$rec" role)"; status="$(kv_get "$rec" status)"
  verdict="$(kv_get "$rec" verdict 2>/dev/null || true)"; head="$(kv_get "$rec" head)"
  round="$(kv_get "$rec" round)"; report="$(kv_get "$rec" report 2>/dev/null || true)"
  max="$(kv_get "$loop" max_rounds 2>/dev/null || echo 3)"

  if [[ "$(ho_head "$root")" != "$head" ]]; then
    action="user:unclean-head"
    detail="${base}：worktree 的 HEAD $(ho_head "$root") 與交件單的 head $head 不同，未交接。"
    next="把 worktree 移回交件單的 commit，或請 Agent 寫新的交件單。"
  elif ! ho_clean "$root"; then
    action="user:unclean-worktree"
    detail="${base}：$root 有未提交的變更，未交接。"
    next="提交或清掉變更後，請 Agent 寫新的交件單。"
  elif ! why="$(ho_pi_record_check "$loop" "$rec")"; then
    action="user:pi-mismatch"
    detail="${base}：Pi 角色與 ${role} 範本不符（${why}），未交接。"
    next="修正角色設定或 Session 的模型後，請 Agent 寫新的交件單。"
  elif [[ "$role" == finish ]]; then
    action="user:finish-$status"
    if [[ "$status" == blocked ]]; then
      detail="收尾停下（${base}）：$(kv_get "$rec" note 2>/dev/null)"
      next="處理後執行：handoff-finish $change"
    else
      outcome="delivered"; kind="finish"; next="收尾結束（status ${status}），迴圈完成。"
    fi
  elif [[ "$status" == blocked || "$verdict" == blocked ]]; then
    action="user:blocked"
    detail="$base 為 blocked：$(kv_get "$rec" note 2>/dev/null)"
    next="處理後請 Agent 寫新的交件單。"
  elif [[ "$role" == implement ]]; then
    to_reviewer "$dir" "$root" "$change" "$head" "$round"
  elif [[ "$verdict" == changes-required ]]; then
    if (( round >= max )); then
      action="user:round-limit"
      detail="已達 $max 輪上限，第 $round 輪審查仍為 changes-required；不再自動退回。"
      next="決定是否繼續：提高 max_rounds 後請實作者修正，或結束迴圈。"
    else
      to_implementer "$dir" "$root" "$change" "$head" "$round" "$report"
    fi
  elif [[ "$verdict" == pass ]]; then
    if [[ "$(kv_get "$loop" finish.trigger 2>/dev/null || echo ask)" == auto ]] && host_missing "$loop" finish; then
      action="skip"
    elif [[ "$(kv_get "$loop" finish.trigger 2>/dev/null || echo ask)" == auto ]]; then
      local impl_dir
      impl_dir="$(kv_get "$loop" implementer.worktree)/.agent-handoff/$change"
      if ! why="$(ho_finish_check "$impl_dir")"; then
        action="user:finish-refused"
        detail="第 $round 輪審查通過，但無法自動收尾：$why"
        next="處理後執行：handoff-finish $change"
      elif why="$(ho_finish_open "$impl_dir" 2>&1)"; then
        action="finish:opened:$why"; outcome="delivered"; kind="review"; out_verdict="pass"
        next="已自動開啟收尾 Session。"
      else
        action="finish:open-failed"; outcome="retry"
        detail="第 $round 輪審查通過，但無法開啟收尾 Session：${why##*$'\n'}"
        next="$(retry_next "$root")"
      fi
    else
      action="user:pass-ask"
      detail="第 $round 輪審查通過（commit ${head:0:7}）。"
      next="請執行：handoff-finish $change"
    fi
  else
    action="user:unknown-record"
    detail="無法判讀交件單 ${base}。"
    next="請 Agent 依 agent-handoff Skill 寫新的交件單。"
  fi

  # A record whose next session's host is not installed is left alone, as if the hook were not installed.
  [[ "$action" == skip ]] && return 0

  # One Xirp query serves the routing log and the agent label. Inside a herdr pane CHIRP_SESSION_ID
  # is inherited from the shell that started herdr, never this agent's (design D7).
  local xsid="${CHIRP_SESSION_ID:-}"; [[ "${HERDR_ENV:-}" == 1 ]] && xsid=""
  # Only an agent's own stop on a first attempt identifies the stopping session. A manual run or a
  # retry may be triggered by someone else, so its environment never names the stopping session.
  local attributed=1
  if [[ "$manual" == 1 ]] || grep -qxF "$base" "$dir/.notified" 2>/dev/null; then attributed=0; fi
  sess_json=""; (( attributed )) && { sess_json="$(ho_xirp_session "$xsid")" || sess_json=""; }
  [[ -n "$sess_json" ]] || sess_json='{}'
  # A Pi record names its own agent (written by handoff-write from the Pi runtime).
  local label model
  model="$(jq -r '.model // "unknown"' <<<"$sess_json" 2>/dev/null || echo unknown)"
  # herdr does not report the model: the log shows the role template's, marked as such (design D8).
  from="$(ho_pi_role_key "$role")"
  [[ -n "$from" && "$(ho_role_host "$loop" "$from")" == herdr ]] && model="$(kv_get "$loop" "$(ho_role_tsec "$from").model" 2>/dev/null)(template)"
  if label="$(ho_pi_record_label "$rec")"; then model="$(kv_get "$rec" agent.provider)/$(kv_get "$rec" agent.model)"; fi
  # The stopping session's identifiers, each in its own namespace: Xirp's, or herdr's pane and the
  # native session ID from the hook input (codex-herdr-r03/F-01).
  local who="session=${xsid:-unknown}" trig=""
  [[ "${HERDR_ENV:-}" == 1 ]] && who="session=herdr:${HERDR_PANE_ID:-unknown} native=${native_session:-unknown}"
  if (( ! attributed )); then
    # The stopping session stays unknown; whoever ran this is named separately, in its own namespace.
    if [[ "${HERDR_ENV:-}" == 1 ]]; then trig="herdr:${HERDR_PANE_ID:-unknown}"; elif [[ -n "$xsid" ]]; then trig="xirp:$xsid"; fi
    who="session=unknown${trig:+ trigger=$trig}"
  fi
  ho_log "$dir" "$base action=$action $who model=$model"
  # Other records do not say who wrote them; the notice names an agent only for an attributed stop.
  local agent_json="$sess_json" sid="$native_session"
  (( attributed )) || { agent_json='{}'; sid=""; }
  [[ -n "$label" ]] || label="$(ho_agent_label "$agent_json")"
  ctx="$(jq -nc --arg c "$change" --arg r "$round" --arg h "${head:0:7}" --arg a "$label" \
    --arg s "$sid" --arg w "$root" '{change:$c, round:$r, commit:$h, agent:$a, session_id:$s, cwd:$w}')"
  if [[ "$outcome" == retry ]]; then
    grep -qxF "$base" "$dir/.notified" 2>/dev/null && return 0
    printf '%s\n' "$base" >> "$dir/.notified"
  fi
  ho_notify "$ctx" "$kind" "$out_verdict" "$next" "$detail"
  [[ "$outcome" == retry ]] || printf '%s\n' "$base" >> "$dir/.routed"
}

# The installed hook is not on PATH, so the retry line names its full path.
retry_next() { printf '原因排除後在 %s 執行：bash ~/.config/wk-workflow/handoff/handoff-route --foreground' "$1"; }

# host_missing <loop.yaml> <role>: the command of the role's host is not installed. Only a step that opens or
# messages a session needs it; notices to the user never do.
host_missing() { ! command -v "$(ho_role_host "$1" "$2")" >/dev/null 2>&1; }

# unconfirmed <who> <session> <host message>: the host may have delivered the text but did not confirm it.
# Sending again could start the same work twice, so the loop stops for the user (outcome stop).
unconfirmed() {
  action="$1:send-unconfirmed:$2"; outcome="stop"
  detail="無法確認${3:+（${3}）}交給 $1 的訊息是否送達（Session $2），未重送，迴圈已停住。"
  next="到該 Session 確認是否收到；沒收到就把檔案裡的訊息貼給它，再刪掉該檔案。刪除前不會再傳訊給這個角色。"
}

# to_reviewer and to_implementer set the caller's action, outcome, kind, next and detail.
to_reviewer() {
  local dir="$1" root="$2" change="$3" head="$4" round="$5" loop="$1/loop.yaml" sess wt mode id out rc
  host_missing "$loop" reviewer && { action="skip"; return; }
  outcome="retry"; next="$(retry_next "$root")"
  sess="$(kv_get "$loop" reviewer.session 2>/dev/null || true)"
  wt="$(kv_get "$loop" reviewer.worktree 2>/dev/null || true)"
  mode="$(kv_get "$loop" review_template.worktree 2>/dev/null || echo shared)"
  # A reviewer whose pane waits for its first prompt (it stopped at a dialog) is opened again: only the prompt is sent.
  if [[ -z "$sess" ]] || ho_role_pending "$dir" reviewer; then
    if [[ "$mode" == new ]]; then
      wt="${root}-review"
      # A retry finds the worktree made by an earlier attempt: move it only when it is clean.
      if [[ -d "$wt" ]] && ! ho_clean "$wt"; then
        action="user:review-worktree-unclean"; outcome="stop"
        detail="審查 worktree $wt 有未提交的變更，未移到新的 commit，也未開啟審查者。"
        next="清理審查 worktree 後，請實作者寫新的交件單。"
        return
      fi
      if [[ -d "$wt" ]]; then git -C "$wt" checkout -q --detach "$head" 2>/dev/null
      else git -C "$root" worktree add -q --detach "$wt" "$head" 2>/dev/null; fi \
        || { action="user:review-worktree-failed"; detail="無法建立審查 worktree ${wt}，第 $round 輪未交給審查者，迴圈已停住。"; return; }
      kv_set "$loop" reviewer.worktree "$wt" \
        || { action="reviewer:open-failed"; detail="無法把審查 worktree 記入 loop.yaml，第 $round 輪未交給審查者，迴圈已停住。"; return; }
      # The reviewer's own loop.yaml must list its worktree (the Pi trigger trusts nothing else).
      mkdir -p "$wt/.agent-handoff/$change" && cp "$loop" "$wt/.agent-handoff/$change/loop.yaml" \
        || { action="reviewer:open-failed"; detail="無法把 loop.yaml 複製到審查 worktree ${wt}，第 $round 輪未交給審查者，迴圈已停住。"; return; }
    else
      wt="$root"
      kv_set "$loop" reviewer.worktree "$wt" \
        || { action="reviewer:open-failed"; detail="無法把審查 worktree 記入 loop.yaml，第 $round 輪未交給審查者，迴圈已停住。"; return; }
    fi
    if out="$(ho_open_role "$dir" review_template "$wt" "$head" "$round" "" 2>&1)"; then
      id="${out##*$'\n'}"
      ho_loop_set "$dir" reviewer.session "$id"
      action="reviewer:opened:$id"; outcome="delivered"; kind="implement"
      next="已開啟審查者的 Session，請其審查第 ${round} 輪。"
    else
      rc=$?
      if (( rc == 2 )); then unconfirmed reviewer "$(kv_get "$loop" reviewer.session 2>/dev/null)" "${out##*$'\n'}"
      else action="reviewer:open-failed"; detail="無法開啟審查 Session（${out##*$'\n'}），第 $round 輪未交給審查者，迴圈已停住。"; fi
    fi
    return
  fi
  [[ -n "$wt" ]] || wt="$root"
  if [[ "$wt" != "$root" ]]; then
    if ! ho_clean "$wt"; then
      action="user:review-worktree-unclean"; outcome="stop"
      detail="審查 worktree $wt 有未提交的變更，未移到新的 commit。"
      next="清理審查 worktree 後，請實作者寫新的交件單。"
      return
    fi
    git -C "$wt" checkout -q --detach "$head" 2>/dev/null \
      || { action="user:review-move-failed"; detail="無法把審查 worktree $wt 移到 ${head:0:7}，第 $round 輪未交給審查者，迴圈已停住。"; return; }
  fi
  out="$(ho_host_message "$(ho_role_host "$loop" reviewer)" "$dir" reviewer "$sess" "[agent-handoff] $change 第 $round 輪：請以 change-review 審查 commit ${head}（worktree ${wt}）。完成後依 agent-handoff Skill 寫 review 交件單。" 2>&1)"; rc=$?
  if (( rc == 0 )); then
    action="reviewer:messaged:$sess"; outcome="delivered"; kind="implement"
    next="已請審查者審查第 $round 輪。"
  elif (( rc == 2 )); then
    unconfirmed reviewer "$sess" "${out##*$'\n'}"
  else
    action="reviewer:send-failed:$sess"
    detail="無法把第 $round 輪交給審查者（Session ${sess}${out:+；${out##*$'\n'}}），迴圈已停住。"
  fi
}

to_implementer() {
  local dir="$1" root="$2" change="$3" head="$4" round="$5" report="$6" loop="$1/loop.yaml" sess abs out rc
  host_missing "$loop" implementer && { action="skip"; return; }
  sess="$(kv_get "$loop" implementer.session)"
  abs="$root/$report"
  out="$(ho_host_message "$(ho_role_host "$loop" implementer)" "$dir" implementer "$sess" "[agent-handoff] $change 第 $round 輪審查結果為 changes-required。受審 commit：${head}。報告：${abs}。請依報告修正，測試通過後本機 commit，再寫 implement 交件單。" 2>&1)"; rc=$?
  if (( rc == 0 )); then
    action="implementer:messaged:$sess"; outcome="delivered"; kind="review"; out_verdict="changes-required"
    next="已把第 $round 輪的審查報告交給實作者修正。"
  elif (( rc == 2 )); then
    unconfirmed implementer "$sess" "${out##*$'\n'}"
  else
    action="implementer:send-failed:$sess"; outcome="retry"
    detail="無法把第 $round 輪的審查報告交給實作者（Session ${sess}${out:+；${out##*$'\n'}}），迴圈已停住。"
    next="$(retry_next "$root")"
  fi
}

if [[ "${1:-}" == "--foreground" ]]; then
  manual=1
  route
elif [[ "${HANDOFF_ROUTE_WAIT:-}" == 1 ]]; then
  route
else
  ( route ) </dev/null >/dev/null 2>&1 &
  disown 2>/dev/null || true
fi
exit 0
