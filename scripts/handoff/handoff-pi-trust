#!/usr/bin/env bash
# Pi trust check for the agent handoff loop, called by the Pi trigger (pi/wk-handoff.ts).
# Usage: handoff-pi-trust <dir>
# Exit 0 only when <dir> is in a linked worktree that an untracked .agent-handoff/<change>/loop.yaml
# there names as a role worktree, and the user already trusts the repository's main worktree in Pi
# (~/.pi/agent/trust.json, nearest saved decision). Anything else exits 1 and Pi decides as usual.
# Never writes trust.json.
set -u

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$here/lib/handoff.sh" ]]; then lib="$here/lib/handoff.sh"
else lib="$HOME/.config/wk-workflow/handoff/lib/handoff.sh"; fi
# shellcheck source=lib/handoff.sh
source "$lib" 2>/dev/null || exit 1

[[ -n "${1:-}" ]] || exit 1
ho_pi_trusts_worktree "$1"
